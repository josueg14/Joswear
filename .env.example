# Copiar a .env. No incluir secretos en Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/joswear?schema=public
APP_URL=http://localhost:3000
# true únicamente para previsualización; las compras de demostración no se persisten.
DEMO_MODE=true
# Vacío hasta recibir el logo original. Archivo dentro de public/, p. ej. /brand/logo.svg
NEXT_PUBLIC_LOGO_URL=
# Secretos aleatorios de 32 bytes, codificados en hex, para cifrar MFA.
MFA_ENCRYPTION_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JOSWEAR
# sandbox no contacta Brevo ni imprime tokens; conserva el trabajo para revisión.
EMAIL_MODE=sandbox
# Aprovisionar fuera del repositorio y borrar después del bootstrap.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TOTP_SECRET=
# Configuración comercial se guarda en SiteSetting desde admin.
# Sin proveedor seleccionado: pagos online deshabilitados en producción.
PAYMENT_PROVIDER=disabled
SANDBOX_WEBHOOK_SECRET=
# Almacenamiento S3 compatible, nunca disco de Render.
STORAGE_UPLOAD_URL=
STORAGE_UPLOAD_TOKEN=
STORAGE_PUBLIC_ORIGIN=
# Definir con responsable legal antes de programar retention --apply.
SECURITY_RETENTION_DAYS=30
