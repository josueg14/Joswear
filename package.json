{
  "name": "joswear",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:bootstrap:if-configured": "tsx scripts/bootstrap-if-configured.ts",
    "email:worker": "tsx scripts/email-worker.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "security:retention": "tsx scripts/retention.ts",
    "test:api": "playwright test --config playwright.api.config.ts",
    "format": "prettier --write src tests scripts prisma/*.ts *.ts *.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.9",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.8.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
